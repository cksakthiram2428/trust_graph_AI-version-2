# -----------------------------------------------------------------------------
# TrustGraph AI - Environment Configuration Template
# -----------------------------------------------------------------------------

# =============================================================================
# 1. Artificial Intelligence & LLM Engine (Required)
# =============================================================================
# Google Gemini API Key: Used for Gemini 3.1 Flash-Lite, Gemini 3.7 Flash,
# Gemini 3.1 Pro Preview, Vision OCR Document Scanning, and Grounding.
GEMINI_API_KEY=

# =============================================================================
# 2. Live Telemetry & Macro Disruption Data Sources (Optional / Recommended)
# =============================================================================
# OpenWeatherMap API: Real-time weather, severe storm alerts, and transport disruption.
# Get free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# NewsAPI: Real-time industry headlines, port strikes, and supply shortage tracking.
# Get free key at: https://newsapi.org/
NEWSAPI_API_KEY=

# Open Government Data (OGD) India: National MSME performance metrics & statistics.
# Get key at: https://data.gov.in/
DATA_GOV_IN_API_KEY=

# World Bank API Key: Macroeconomic growth, logistics performance, and inflation indices.
# (Publicly accessible; key provides higher rate limits)
WORLD_BANK_API_KEY=

# OpenFDA API Key: Pharmaceutical/medical device recalls and regulatory compliance.
OPENFDA_API_KEY=

# =============================================================================
# 3. Persistence & Identity (Automatically Managed by Google AI Studio)
# =============================================================================
# Google Cloud / Firebase Project ID for Firestore and Authentication
FIREBASE_PROJECT_ID=


