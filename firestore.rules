rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read public supply chain data; authenticated users can write and manage records
    match /suppliers/{supplierId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /chat_messages/{messageId} {
      allow read, write: if request.auth != null || true;
    }

    match /simulation_logs/{logId} {
      allow read, write: if request.auth != null || true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /admin-logs/{logId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /system-metrics/{metricId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /active-sessions/{sessionId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
  }
}

