{
  "entities": {
    "suppliers": {
      "title": "Suppliers",
      "description": "Monitored supply chain entities with credit, logistics, and trust scores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "tier": { "type": "string" },
        "score": { "type": "number" },
        "risk": { "type": "string" },
        "riskIcon": { "type": "string" },
        "riskColor": { "type": "string" },
        "insight": { "type": "string" },
        "paymentDelay": { "type": "string" },
        "deliveryReliability": { "type": "string" },
        "qualityRate": { "type": "string" },
        "complaintCount": { "type": "number" },
        "criticality": { "type": "string" },
        "leadTimeDays": { "type": "number" },
        "monthlyVolumeINR": { "type": "string" },
        "city": { "type": "string" },
        "gstin": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "score", "risk"]
    },
    "users": {
      "title": "Platform Users & Real-Time Presence",
      "description": "Authenticated procurement directors, risk auditors, and enterprise admins with live presence",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "provider": { "type": "string", "enum": ["google", "microsoft", "github", "password"] },
        "role": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "lastActivity": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["online", "active", "away", "offline"] },
        "currentView": { "type": "string", "enum": ["3D_SPACE", "2D_TOPOLOGY", "RISK_MATRIX"] },
        "supplierFocus": { "type": "string" },
        "sessionDuration": { "type": "number" },
        "mouseActivity": { "type": "boolean" },
        "cursorPosition": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        }
      },
      "required": ["uid", "email"]
    },
    "admin_logs": {
      "title": "Admin Operation Logs",
      "description": "Real-time audit log of MSME CSV ingestions, supplier modifications, risk rectifications, and administrative actions",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "category": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "details": { "type": "string" },
        "metadata": { "type": "object" },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "timestamp"]
    },
    "system_metrics": {
      "title": "System Performance Metrics",
      "description": "Automated performance tracking snapshots with API latencies, error counts, and AI metrics",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "apiLatencies": { "type": "object" },
        "errorCounts": { "type": "number" },
        "status": { "type": "string" },
        "firebaseStatus": { "type": "string" },
        "geminiCallsCount": { "type": "number" }
      },
      "required": ["timestamp", "status"]
    },
    "active_sessions": {
      "title": "Active User Sessions",
      "description": "Multi-user live sessions for collaboration and view synchronizations",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "displayName": { "type": "string" },
        "loginTime": { "type": "string" },
        "lastSeen": { "type": "string" },
        "currentView": { "type": "string" }
      },
      "required": ["sessionId", "userId", "loginTime"]
    },
    "chat_messages": {
      "title": "Chat Messages",
      "description": "Multi-turn Gemini intelligence chat records with system instructions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "model": { "type": "string" },
        "timestamp": { "type": "string" },
        "groundingSources": { "type": "array" }
      },
      "required": ["role", "content", "timestamp"]
    },
    "simulation_logs": {
      "title": "Simulation Logs",
      "description": "High-thinking systemic contagion cascade shockwave results",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "supplierName": { "type": "string" },
        "shockType": { "type": "string" },
        "exposure": { "type": "string" },
        "downtimeDays": { "type": "number" },
        "narrative": { "type": "string" },
        "deepThinkingAnalysis": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["supplierName", "shockType", "createdAt"]
    }
  },
  "firestore": {
    "/suppliers/{supplierId}": {
      "schema": "suppliers",
      "description": "Primary repository of supply chain suppliers"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles and real-time presence indicators"
    },
    "/admin-logs/{logId}": {
      "schema": "admin_logs",
      "description": "Administrative action logs and audit trail"
    },
    "/system-metrics/{metricId}": {
      "schema": "system_metrics",
      "description": "Periodic system health and latency benchmarks"
    },
    "/active-sessions/{sessionId}": {
      "schema": "active_sessions",
      "description": "Live active user session tracking"
    },
    "/chat_messages/{messageId}": {
      "schema": "chat_messages",
      "description": "Gemini AI Copilot chat history"
    },
    "/simulation_logs/{logId}": {
      "schema": "simulation_logs",
      "description": "Contagion simulation cascade histories"
    }
  }
}

